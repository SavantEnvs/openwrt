#
# Automatically generated file; DO NOT EDIT.
# OpenWrt Configuration
#
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y

#
# Target Selection
#
# CONFIG_TARGET_ath79 is not set
# CONFIG_TARGET_ramips is not set
CONFIG_TARGET_x86=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_ROOTFS_PARTSIZE=256
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_LOADADDR=0x80080000
CONFIG_TARGET_VERSION_REPO="https://example.org/releases"
# end of Target Selection

#
# Global build settings
#
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
# CONFIG_CCACHE is not set
CONFIG_SIGNED_PACKAGES=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_SWAP=m
CONFIG_KERNEL_LOG_BUF_SHIFT=18
CONFIG_EXTRA_OPTIMIZATION="-O2"
CONFIG_IB=y
CONFIG_SDK_NEEDED=y
# end of Global build settings

#
# Base system
#
CONFIG_PACKAGE_busybox=m
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING=y
CONFIG_BUSYBOX_CONFIG_FEATURE_EDITING_HISTORY=512
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_libc=y

#
# Network
#
CONFIG_PACKAGE_hostapd=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_wpad-basic=y
# end of Base system
